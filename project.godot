;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pawsfield"
run/main_scene="uid://bj6rym7kmoijs"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

ToolManager="*uid://bf3x46elyq4w8"
InventoryManager="*uid://chj4q0arit4jv"
DayAndNightCycleManager="*uid://cy351uhqivo10"
SaveGameManager="*uid://ce00bb0dhvpv3"
DialogueManager="*uid://c3rodes2l3gxb"
GameDialogueManager="*uid://4lw87t08bcny"
GameManager="*uid://brm8phhbgxo47"
SceneManager="*uid://di2tw5bvqkfpf"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
